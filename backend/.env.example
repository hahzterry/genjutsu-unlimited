# copy to .env and fill in
# comma-separated residential proxies (rotated per attempt)
PROXY_LIST=socks5://user:pass@host:1080,socks5://user2:pass2@host2:1080
# run browser headless on the server
HEADLESS=true
# browser locale
BROWSER_LOCALE=en-US
# CORS — your vercel frontend URL
CORS_ORIGINS=https://higgsfield-genjutsu-unlimited.vercel.app
# where downloaded videos are stored
VIDEO_DIR=./videos
