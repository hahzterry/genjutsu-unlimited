# copy to .env and fill in
# comma-separated residential proxies (rotated per new account — fresh IP each time)
# Use socks5h:// for DNS-over-proxy (prevents DNS leak). Recommended: residential/mobile proxies.
PROXY_LIST=socks5h://user:pass@host:1080,socks5h://user2:pass2@host2:1080
# run browser headless on the server
HEADLESS=true
# browser locale
BROWSER_LOCALE=en-US
# CORS — your vercel frontend URL (comma-separated for multiple)
CORS_ORIGINS=https://higgsfield-genjutsu-unlimited.vercel.app
# where downloaded videos are stored
VIDEO_DIR=/tmp/videos
# where uploaded references are stored
UPLOAD_DIR=/tmp/uploads
# where failure screenshots go
DEBUG_DIR=/tmp/debug
# parallel generation workers per VM
MAX_WORKERS=2
# overall timeout per generation (seconds)
RUN_TIMEOUT=300
# --- Security ---
# API key for auth (if empty, auth disabled — set this in production!)
API_KEY=change-me-to-a-long-random-string
# Rate limit: max requests per minute per IP (0 = disabled)
RATE_LIMIT=0
# Job TTL: seconds before completed jobs are cleaned up (default 1 hour)
JOB_TTL=3600
